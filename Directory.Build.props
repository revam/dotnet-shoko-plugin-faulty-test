<Project>
    <PropertyGroup>
        <!-- Point this at a Shoko checkout to build against its projects
             instead of the package below. -->
        <ShokoRepositoryPath Condition="'$(ShokoRepositoryPath)' == ''"></ShokoRepositoryPath>

        <!-- Used only without a checkout. -->
        <ShokoAbstractionsVersion>6.0.0-alpha.104</ShokoAbstractionsVersion>
    </PropertyGroup>
</Project>
